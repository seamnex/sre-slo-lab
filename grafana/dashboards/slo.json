      "type": "timeseries",
      "title": "Latencia de checkout",
      "description": "Percentiles estimados del histograma. La línea roja es el límite del SLO (300 ms). El SLO NO se calcula con el p99: se calcula contando pedidos por debajo del bucket de 0,3 s.",
      "gridPos": {
        "h": 8,
        "w": 8,
        "x": 8,
        "y": 14
      },
      "targets": [
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.99, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"checkout\",route=\"/api/checkout\"}[5m])))",
          "legendFormat": "p99",
          "refId": "A"
        },
        {
          "datasource": {
            "type": "prometheus",
            "uid": "prometheus"
          },
          "expr": "histogram_quantile(0.50, sum by (le) (rate(http_request_duration_seconds_bucket{job=\"checkout\",route=\"/api/checkout\"}[5m])))",
          "legendFormat": "p50",
          "refId": "B"
        }
